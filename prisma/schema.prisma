generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum DeliveryType {
  AUTOMATIC_API
  MANUAL
  INTERNAL_STOCK
}

enum OrderStatus {
  PENDING
  WAITING_PAYMENT
  PAID
  PROCESSING
  DELIVERED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum TicketStatus {
  OPEN
  WAITING_CUSTOMER
  WAITING_SUPPORT
  CLOSED
}

enum WalletTopUpStatus {
  PENDING
  APPROVED
  FAILED
  CANCELLED
}

enum WalletTransactionType {
  TOP_UP
  ORDER_PAYMENT
  ADMIN_CREDIT
}

model User {
  id           String               @id @default(cuid())
  name         String
  email        String               @unique
  passwordHash String
  role         UserRole             @default(CUSTOMER)
  status       UserStatus           @default(ACTIVE)
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  orders       Order[]
  tickets      Ticket[]
  messages     TicketMessage[]
  auditLogs    AuditLog[]
  wallet       Wallet?
  walletTopUps WalletTopUp[]
  pushSubscriptions AdminPushSubscription[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  description      String
  shortDescription String
  image            String?
  price            Decimal          @db.Decimal(12, 2)
  cost             Decimal          @db.Decimal(12, 2)
  status           ProductStatus    @default(DRAFT)
  deliveryType     DeliveryType     @default(MANUAL)
  availableStock   Int              @default(0)
  stockSynced      Boolean          @default(false)
  lastSyncedAt     DateTime?
  instructions     String?
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  supplierProduct  SupplierProduct?
  attachments      Attachment[]
  stock            Stock[]
  orderItems       OrderItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, categoryId, createdAt])
  @@index([price])
}

model Supplier {
  id        String            @id @default(cuid())
  name      String
  provider  String            @unique
  active    Boolean           @default(false)
  products  SupplierProduct[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model SupplierProduct {
  id           String    @id @default(cuid())
  supplierId   String
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  productId    String    @unique
  product      Product   @relation(fields: [productId], references: [id])
  externalCode String
  quantity     Int       @default(0)
  cost         Decimal?  @db.Decimal(12, 2)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([supplierId, externalCode])
}

model Order {
  id                 String               @id @default(cuid())
  number             Int                  @unique @default(autoincrement())
  idempotencyKey     String               @unique
  userId             String
  user               User                 @relation(fields: [userId], references: [id])
  status             OrderStatus          @default(PENDING)
  subtotal           Decimal              @db.Decimal(12, 2)
  total              Decimal              @db.Decimal(12, 2)
  items              OrderItem[]
  history            OrderStatusHistory[]
  payments           Payment[]
  walletTransactions WalletTransaction[]
  tickets            Ticket[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id])
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  productName  String
  unitPrice    Decimal      @db.Decimal(12, 2)
  unitCost     Decimal      @db.Decimal(12, 2)
  quantity     Int
  deliveryType DeliveryType
  delivery     Delivery?
  stock        Stock[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  reason    String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  provider       String
  externalId     String?
  idempotencyKey String        @unique
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(12, 2)
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([provider, externalId])
  @@index([orderId])
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  transactions WalletTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model WalletTopUp {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount            Decimal             @db.Decimal(12, 2)
  status            WalletTopUpStatus   @default(PENDING)
  idempotencyKey    String              @unique
  preferenceId      String?             @unique
  externalPaymentId String?             @unique
  confirmedAt       DateTime?
  transactions      WalletTransaction[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId, createdAt])
}

model WalletTransaction {
  id             String                @id @default(cuid())
  walletId       String
  wallet         Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type           WalletTransactionType
  amount         Decimal               @db.Decimal(12, 2)
  idempotencyKey String                @unique
  topUpId        String?
  topUp          WalletTopUp?          @relation(fields: [topUpId], references: [id])
  orderId        String?
  order          Order?                @relation(fields: [orderId], references: [id])
  createdAt      DateTime              @default(now())

  @@index([walletId, createdAt])
}

model Stock {
  id               String     @id @default(cuid())
  productId        String
  product          Product    @relation(fields: [productId], references: [id])
  encryptedContent String
  orderItemId      String?
  orderItem        OrderItem? @relation(fields: [orderItemId], references: [id])
  reservedAt       DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([productId, orderItemId])
}

model Delivery {
  id                    String         @id @default(cuid())
  orderItemId           String         @unique
  orderItem             OrderItem      @relation(fields: [orderItemId], references: [id])
  idempotencyKey        String         @unique
  status                DeliveryStatus @default(PENDING)
  encryptedContent      String?
  externalReservationId String?
  errorCode             String?
  deliveredAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model Ticket {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  orderId   String?
  order     Order?          @relation(fields: [orderId], references: [id])
  subject   String
  category  String
  status    TicketStatus    @default(OPEN)
  messages  TicketMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

model AdminPushSubscription {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
}

model TicketMessage {
  id          String       @id @default(cuid())
  ticketId    String
  ticket      Ticket       @relation(fields: [ticketId], references: [id])
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  body        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments Attachment[]

  @@index([ticketId, createdAt])
}

model Attachment {
  id              String         @id @default(cuid())
  url             String
  publicId        String
  filename        String
  contentType     String
  bytes           Int
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  ticketMessageId String?
  ticketMessage   TicketMessage? @relation(fields: [ticketMessageId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@index([productId])
  @@index([ticketMessageId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
